{
  "expo": {
    "name": "ParkEasy Mobile",
    "slug": "parkeasy-mobile",
    "scheme": "parkeasymobile",
    "version": "1.0.0",
    "icon": "./assets/branding/app-logo.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parking.mobile"
    },
    "android": {
      "package": "com.parking.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    }
  }
}
