{
  "name": "smart-parking-reservation-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace apps/mobile run start",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build:admin": "npm --workspace apps/admin run build",
    "test:mobile": "npm --workspace apps/mobile run test",
    "test": "npm run test:mobile"
  },
  "dependencies": {
    "expo-camera": "~16.0.18",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1"
  }
}
