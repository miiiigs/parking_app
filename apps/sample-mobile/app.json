{
  "expo": {
    "name": "ParkEasy Sample Mobile",
    "slug": "parkeasy-sample-mobile",
    "scheme": "parkeasysample",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parking.samplemobile"
    },
    "android": {
      "package": "com.parking.samplemobile"
    }
  }
}
