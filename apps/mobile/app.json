{
  "expo": {
    "name": "ParkEasy Mobile",
    "slug": "parkeasy-mobile",
    "scheme": "parkeasymobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parking.mobile"
    },
    "android": {
      "package": "com.parking.mobile"
    }
  }
}
